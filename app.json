{
  "expo": {
    "name": "ScoreBook",
    "slug": "scorebook",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "scorebook",
    "userInterfaceStyle": "light",
    "description": "Keep score for badminton, tennis, table tennis and pickleball. Play everyone against everyone, a knockout, or groups followed by a knockout. See live standings and share the results. Works offline, no account needed.",
    "ios": {
      "icon": "./assets/images/icon-1024.png",
      "bundleIdentifier": "com.moneshms.scorebook",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moneshms.scorebook",
      "versionCode": 9,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, viewport-fit=cover"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F6",
          "imageWidth": 240,
          "resizeMode": "contain",
          "image": "./assets/images/splash-icon-square.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "923aff95-7f43-421c-b647-a0ea9c47b38a"
      }
    }
  }
}
